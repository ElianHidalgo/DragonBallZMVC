@model IEnumerable<DragonBallZMVC.Models.Tecnica>

@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.NombreTecnica)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Tipo)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.NivelDano)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.NombreTecnica)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Tipo)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.NivelDano)
        </td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { id=item.TecnicaId }) |
            @Html.ActionLink("Details", "Details", new { id=item.TecnicaId }) |
            @Html.ActionLink("Delete", "Delete", new { id=item.TecnicaId })
        </td>
    </tr>
}

</table>
